    "undici": "8.12.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/m3u8-parser": "7.2.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "oxfmt": "^0.2.0",
    "playwright": "^1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.0"
